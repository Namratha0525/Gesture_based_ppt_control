        "print(\"Input  dtype        :\", input_details[0][\"dtype\"])\n",
        "print(\"Output tensor shape :\", output_details[0][\"shape\"])\n",
        "\n",
        "# ── Run on 5 random test samples ─────────────────────────────\n",
        "rng_test = np.random.default_rng(99)\n",
        "indices  = rng_test.choice(len(X_test), size=5, replace=False)\n",
