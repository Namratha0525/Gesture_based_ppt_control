        "# ============================================================\n",
        "# CELL 7 — Synthetic Gesture Generation\n",
        "# ============================================================\n",
        "#\n",
        "# Existing real classes:\n",
        "#   open_palm\n",
        "#   closed_fist\n",
        "#   peace\n",
        "#\n",
        "# Synthetic classes:\n",
        "#   swipe_right  (open palm shifted right)\n",
        "#   swipe_left   (open palm shifted left)\n",
        "#   pinch        (thumb tip moved toward index tip)\n",
        "#\n",
        "# Final Classes:\n",
        "#   open_palm\n",
        "#   closed_fist\n",
        "#   peace\n",
        "#   swipe_right\n",
        "#   swipe_left\n",
        "#   pinch\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Use open_palm as base for synthetic gesture generation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "palm_mask = (y_labels_str == \"open_palm\")\n",
        "\n",
        "X_palm_raw = X_raw[palm_mask]\n",
        "\n",
        "n_palm = len(X_palm_raw)\n",
        "\n",
        "n_synth = n_palm\n",
        "\n",
        "print(f\"Using {n_synth} open_palm samples as synthetic base.\")\n",
        "\n",
        "# ============================================================\n",
        "# Swipe Gesture Generator\n",
        "# ============================================================\n",
        "\n",
        "def make_swipe_samples(\n",
        "    X_base_63,\n",
        "    shift_range,\n",
        "    label_name,\n",
        "    n_aug,\n",
        "    seed=0\n",
        "):\n",
        "\n",
        "    rng_local = np.random.default_rng(seed)\n",
        "\n",
        "    idx = rng_local.choice(\n",
        "        len(X_base_63),\n",
        "        size=n_aug,\n",
        "        replace=(n_aug > len(X_base_63))\n",
        "    )\n",
        "\n",
        "    X_sel = X_base_63[idx].copy()\n",
        "\n",
        "    for i in range(len(X_sel)):\n",
        "\n",
        "        shift = rng_local.uniform(\n",
        "            shift_range[0],\n",
        "            shift_range[1]\n",
        "        )\n",
        "\n",
        "        # Shift x coordinates only\n",
        "        X_sel[i, 0:21] += shift\n",
        "\n",
        "        # Small landmark noise\n",
        "        X_sel[i] += rng_local.normal(\n",
        "            0,\n",
        "            0.01,\n",
        "            X_sel[i].shape\n",
        "        )\n",
        "\n",
        "    X_feat = np.array(\n",
        "        [extract_features(row) for row in X_sel],\n",
        "        dtype=np.float32\n",
        "    )\n",
        "\n",
        "    y_feat = np.array(\n",
        "        [label_name] * n_aug\n",
        "    )\n",
        "\n",
        "    return X_feat, y_feat\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Pinch Generator\n",
        "# ============================================================\n",
        "\n",
        "def make_pinch_samples(\n",
        "    X_base_63,\n",
        "    n_aug,\n",
        "    seed=2\n",
        "):\n",
        "\n",
        "    rng_local = np.random.default_rng(seed)\n",
        "\n",
        "    idx = rng_local.choice(\n",
        "        len(X_base_63),\n",
        "        size=n_aug,\n",
        "        replace=(n_aug > len(X_base_63))\n",
        "    )\n",
        "\n",
        "    X_sel = X_base_63[idx].copy()\n",
        "\n",
        "    for i in range(len(X_sel)):\n",
        "\n",
        "        x = X_sel[i, 0:21]\n",
        "        y = X_sel[i, 21:42]\n",
        "        z = X_sel[i, 42:63]\n",
        "\n",
        "        lm = np.stack([x, y, z], axis=1)\n",
        "\n",
        "        # Thumb tip\n",
        "        thumb_tip = lm[4]\n",
        "\n",
        "        # Index tip\n",
        "        index_tip = lm[8]\n",
        "\n",
        "        midpoint = (\n",
        "            thumb_tip + index_tip\n",
        "        ) / 2\n",
        "\n",
        "        # Move thumb and index toward each other\n",
        "        lm[4] = midpoint + rng_local.normal(\n",
        "            0,\n",
        "            0.01,\n",
        "            3\n",
        "        )\n",
        "\n",
        "        lm[8] = midpoint + rng_local.normal(\n",
        "            0,\n",
        "            0.01,\n",
        "            3\n",
        "        )\n",
        "\n",
        "        X_sel[i] = np.concatenate([\n",
        "            lm[:, 0],\n",
        "            lm[:, 1],\n",
        "            lm[:, 2]\n",
        "        ])\n",
        "\n",
        "    X_sel += rng_local.normal(\n",
        "        0,\n",
        "        0.01,\n",
        "        X_sel.shape\n",
        "    )\n",
        "\n",
        "    X_feat = np.array(\n",
        "        [extract_features(row) for row in X_sel],\n",
        "        dtype=np.float32\n",
        "    )\n",
        "\n",
        "    y_feat = np.array(\n",
