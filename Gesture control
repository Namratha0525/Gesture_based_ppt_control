        "\n",
        "    if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {{\n",
        "      const lm = results.multiHandLandmarks[0];\n",
        "      const xs = lm.map(p => p.x.toFixed(6));\n",
        "      const ys = lm.map(p => p.y.toFixed(6));\n",
