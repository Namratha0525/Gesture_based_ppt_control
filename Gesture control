        "# ============================================================\n",
        "# CELL 6 — Feature Engineering (94 Features)\n",
        "# ============================================================\n",
        "#\n",
        "# Raw Features:\n",
        "#   63 = x0-x20 + y0-y20 + z0-z20\n",
        "#\n",
        "# Engineered Features:\n",
        "#   15 = Finger Joint Angles (5 fingers × 3 angles)\n",
        "#    5 = Fingertip → Wrist distances\n",
        "#    5 = Fingertip → Thumb-tip distances\n",
        "#    6 = Important inter-landmark distances\n",
        "#\n",
        "# Total:\n",
        "#   63 + 15 + 5 + 5 + 6 = 94 Features\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# MediaPipe landmark indices\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "WRIST_ID = 0\n",
        "\n",
        "FINGERTIP_IDS = [\n",
        "    4,   # Thumb tip\n",
        "    8,   # Index tip\n",
        "    12,  # Middle tip\n",
        "    16,  # Ring tip\n",
        "    20   # Pinky tip\n",
        "]\n",
        "\n",
        "# Use wrist as anchor so each finger has 5 landmarks\n",
        "# => 3 angles per finger\n",
        "FINGER_CHAINS = [\n",
        "    [0, 1, 2, 3, 4],        # Thumb\n",
        "    [0, 5, 6, 7, 8],        # Index\n",
        "    [0, 9, 10, 11, 12],     # Middle\n",
        "    [0, 13, 14, 15, 16],    # Ring\n",
        "    [0, 17, 18, 19, 20]     # Pinky\n",
        "]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Feature Extraction Function\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def extract_features(row_vals):\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Dataset format:\n",
        "    # x0..x20 | y0..y20 | z0..z20\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    x = row_vals[0:21]\n",
        "    y = row_vals[21:42]\n",
        "    z = row_vals[42:63]\n",
        "\n",
        "    # Shape = (21,3)\n",
        "    lm = np.stack([x, y, z], axis=1)\n",
        "\n",
        "    # Start with original 63 features\n",
        "    features = list(row_vals)\n",
        "\n",
        "    # ========================================================\n",
        "    # A) Finger Joint Angles (15)\n",
        "    # ========================================================\n",
        "\n",
        "    for chain in FINGER_CHAINS:\n",
        "\n",
        "        for i in range(len(chain) - 2):\n",
        "\n",
        "            p1 = lm[chain[i]]\n",
        "            p2 = lm[chain[i + 1]]\n",
        "            p3 = lm[chain[i + 2]]\n",
        "\n",
        "            v1 = p1 - p2\n",
        "            v2 = p3 - p2\n",
        "\n",
        "            norm1 = np.linalg.norm(v1) + 1e-8\n",
        "            norm2 = np.linalg.norm(v2) + 1e-8\n",
        "\n",
        "            cosine = np.dot(v1, v2) / (norm1 * norm2)\n",
        "            cosine = np.clip(cosine, -1.0, 1.0)\n",
        "\n",
        "            angle = np.arccos(cosine)\n",
        "\n",
        "            features.append(float(angle))\n",
        "\n",
        "    # ========================================================\n",
        "    # B) Fingertip → Wrist Distances (5)\n",
        "    # ========================================================\n",
        "\n",
        "    wrist = lm[WRIST_ID]\n",
        "\n",
        "    for tip_id in FINGERTIP_IDS:\n",
        "\n",
        "        dist = np.linalg.norm(\n",
        "            lm[tip_id] - wrist\n",
        "        )\n",
        "\n",
        "        features.append(float(dist))\n",
        "\n",
        "    # ========================================================\n",
        "    # C) Fingertip → Thumb Tip Distances (5)\n",
        "    # ========================================================\n",
        "\n",
        "    thumb_tip = lm[4]\n",
        "\n",
        "    for tip_id in FINGERTIP_IDS:\n",
        "\n",
        "        dist = np.linalg.norm(\n",
        "            lm[tip_id] - thumb_tip\n",
        "        )\n",
        "\n",
        "        features.append(float(dist))\n",
        "\n",
        "    # ========================================================\n",
        "    # D) Key Hand Geometry Distances (6)\n",
        "    # ========================================================\n",
        "\n",
        "    important_pairs = [\n",
        "\n",
        "        (5, 17),   # Palm width\n",
        "\n",
        "        (0, 9),    # Wrist → middle MCP\n",
        "\n",
        "        (4, 8),    # Thumb ↔ Index\n",
        "\n",
        "        (8, 12),   # Index ↔ Middle\n",
        "\n",
        "        (12, 16),  # Middle ↔ Ring\n",
        "\n",
        "        (16, 20)   # Ring ↔ Pinky\n",
        "    ]\n",
        "\n",
        "    for a, b in important_pairs:\n",
        "\n",
        "        dist = np.linalg.norm(\n",
        "            lm[a] - lm[b]\n",
        "        )\n",
        "\n",
        "        features.append(float(dist))\n",
        "\n",
        "    return np.array(features, dtype=np.float32)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Build Feature Matrix\n",
        "# ============================================================\n",
        "\n",
        "feature_cols = [\n",
        "    c for c in df_mapped.columns\n",
        "    if c != \"label\"\n",
        "]\n",
        "\n",
        "X_raw = df_mapped[feature_cols].values.astype(np.float32)\n",
        "\n",
        "y_labels_str = df_mapped[\"label\"].values\n",
        "\n",
        "# Safety Check\n",
        "assert X_raw.shape[1] == 63, (\n",
        "    f\"Expected 63 raw features, got {X_raw.shape[1]}\"\n",
        ")\n",
        "\n",
        "# Extract Features\n",
        "X_engineered = np.array(\n",
        "    [extract_features(row) for row in X_raw],\n",
        "    dtype=np.float32\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# Verification\n",
        "# ============================================================\n",
        "\n",
        "EXPECTED_FEATURES = 94\n",
        "\n",
        "assert X_engineered.shape[1] == EXPECTED_FEATURES, (\n",
        "    f\"Expected {EXPECTED_FEATURES} features, \"\n",
        "    f\"got {X_engineered.shape[1]}\"\n",
        ")\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"FEATURE ENGINEERING COMPLETE\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"Raw Features       :\", X_raw.shape[1])\n",
        "print(\"Engineered Features:\", X_engineered.shape[1])\n",
        "print(\"Total Samples      :\", X_engineered.shape[0])\n",
        "print(\"Classes Present    :\", sorted(np.unique(y_labels_str)))\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"✅ Feature extraction successful\")"
      ],
